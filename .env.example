# Copy this file to .env and fill in what you need:
#
#     cp .env.example .env
#
# .env holds real secrets and is never committed — it is in .gitignore.
# This file is committed, so keep it to placeholders and never paste a real
# key in here.
#
# Nothing below is needed to run the week-1 stubs. They read no environment
# variables at all.
#
# Heads up: as of week 1 no code reads this file yet — build_index.py hardcodes
# its own settings. These are the agreed names for when it does, so change the
# code and this file together rather than letting them drift.

# --- LLM -------------------------------------------------------------------
# A hosted API model; Matteo picks which one in week 1. Set the key for the
# provider we land on and leave the other blank — the SDKs read these names
# directly.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# The model id, once chosen. e.g. claude-sonnet-5-5
ASKWESTERN_LLM_MODEL=

# If there is no budget, the plan's fallback is a local model via Ollama.
# Leave this as-is unless you are running one.
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings ------------------------------------------------------------
# Local and free, so no key. This is ChromaDB's bundled default, which
# build_index.py relies on. Tanya may change it while tuning hit rate.
ASKWESTERN_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector store ----------------------------------------------------------
# ChromaDB persists to a folder on disk, rebuilt by re-running the indexer and
# never committed. This matches build_index.py's current path and collection.
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION=askwestern

# --- Scraper ---------------------------------------------------------------
# The plan commits us to identifying ourselves and waiting at least a second
# between requests. Do not lower the delay.
# build_index.py currently hardcodes "AskWesternBot/0.1" instead; the plan asks
# for a user-agent that says this is the WCS AskWestern project.
ASKWESTERN_USER_AGENT=WCS-AskWestern/0.1 (Western CS student project)
ASKWESTERN_REQUEST_DELAY_S=1.0
